{
  "name": "remote-desktop-commander",
  "version": "1.0.79",
  "description": "Remote Desktop Commander: use files, terminal and processes on your own computers from any AI app.",
  "mcpServers": {
    "remote-desktop-commander": {
      "httpUrl": "https://mcp.desktopcommander.app/mcp",
      "oauth": {
        "enabled": true,
        "clientId": "gemini-cli-remote-desktop-commander",
        "authorizationUrl": "https://mcp.desktopcommander.app/authorize",
        "tokenUrl": "https://mcp.desktopcommander.app/token",
        "scopes": [
          "mcp:tools"
        ]
      }
    }
  }
}
